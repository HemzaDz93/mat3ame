# ==================================================================
#  ملف بيئة منصة الزاوية — نسخة Wasmer Edge
#  هذا الملف يُنسخ تلقائياً باسم  .env  داخل حزمة الرفع.
#  لا تضع أي تعليق في نهاية نفس السطر (تختلط القيمة بالتعليق).
# ==================================================================

APP_NAME="منصة الزاوية"
APP_ENV=production

# اتركه فارغاً هنا، ثم اضبطه على Wasmer بالأمر:
#   wasmer app secrets create APP_KEY "base64:qxAfUP83jkUZQ6cuVP8V/xeNTAvx1R1rv6AmnIHka+g="
APP_KEY=

APP_DEBUG=false

# ⚠️ استبدل هذا بالرابط النهائي الذي يظهر بعد النشر
#     الصيغة: https://<اسم-التطبيق>-<اسم-حسابك>.wasmer.app
APP_URL=https://mat3am-YOUR-WASMER-USERNAME.wasmer.app

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_DZ
APP_TIMEZONE=Africa/Algiers

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ------------------------------------------------------------------
# قاعدة البيانات
# لا تضع DB_HOST/DB_PORT/DB_NAME/DB_USERNAME/DB_PASSWORD هنا.
# منصة Wasmer تحقنها تلقائياً بعد إنشاء قاعدة البيانات من app.yaml
# (لاحظ أنها تستخدم الاسم DB_NAME وليس DB_DATABASE، وقد تم ربط
#  الاسمين في config/database.php ليعمل النظام بشكل صحيح).
# ------------------------------------------------------------------
DB_CONNECTION=mysql

# شهادة خادم قاعدة البيانات موقّعة من جهة خاصة (private CA)
# لذا يجب تشفير الاتصال دون التحقق من السلسلة.
DB_SSL_VERIFY_SERVER_CERT=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.dz"
MAIL_FROM_NAME="${APP_NAME}"

# كلمة مرور المدير الأول (تُستخدم عند تنفيذ: php artisan app:create-admin)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# اتركه فارغاً؛ النظام ينشئ النسخة الاحتياطية عبر PHP (لا يوجد mysqldump)
BACKUP_MYSQLDUMP_PATH=
