APP_NAME="منصة الزاوية"
APP_ENV=local
APP_KEY=
# أبقِها false في أي بيئة حقيقية لمنع كشف المسارات ومتغيرات البيئة عند الأخطاء.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zawia
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# اجعلها على النطاق الفعلي في الإنتاج، مع تفعيل HTTPS
SESSION_DOMAIN=null
# أبقِها true عند العمل عبر HTTPS لمنع إرسال كوكي الجلسة عبر اتصال غير مشفّر.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.dz"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# متغيرات خاصة بالمنصة
# ------------------------------------------------------------------

# حساب المدير الأول (يُستخدم مع: php artisan db:seed أو php artisan app:create-admin)
# اتركه فارغًا في الإنتاج واستعمل الأمر التفاعلي لتفادي تخزين كلمة المرور في ملفات البيئة.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# كلمة مرور الحسابات التجريبية (DemoSeeder) — بيئة التطوير فقط.
# لا تُشغَّل البيانات التجريبية إلا في local/testing؛ غيّر كلمة المرور أو اتركها فارغة لاستخدام الافتراضي.
DEMO_PASSWORD=

# مسار ملف mysqldump التنفيذي (اختياري).
# عند تركه فارغًا تبحث المنصة تلقائيًا عن المسارات الشائعة، ثم تعود إلى نسخة احتياطية مبنية على PDO.
# مثال على cPanel: /usr/bin/mysqldump
BACKUP_MYSQLDUMP_PATH=
